{
  "name": "recursica-proto-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run format && npm run lint:fix && npm run lint && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css,scss}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,css,scss}\"",
    "check-types": "tsc -b",
    "precommit": "npm run check-types && npm run lint && npm run format",
    "prepare": "node .husky/install.mjs",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "dependencies": {
    "@mantine/core": "^8.3.18",
    "@mantine/dates": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@recursica/mantine-adapter": "^0.35.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.25.0",
    "@recursica/recursica-postcss-vars": "1.5.0",
    "@types/node": "26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss": "8.5.16",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "3.5.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.30.1",
    "vite": "^8.1.0"
  }
}
